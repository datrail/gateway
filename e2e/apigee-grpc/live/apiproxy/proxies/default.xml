<?xml version="1.0" encoding="UTF-8"?>
<ProxyEndpoint name="default">
  <FaultRules>
    <!-- EC-Rail's own faults only (unreachable, timed out, refused by IAM, a
         gRPC error) fail closed; another policy's fault keeps its own error.
         Names the policy: rename both together. -->
    <FaultRule name="callout-failed">
      <Step>
        <Name>RF-CalloutFailed</Name>
      </Step>
      <Condition>externalcallout.EC-Rail.failed = true</Condition>
    </FaultRule>
  </FaultRules>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>EC-Rail</Name>
      </Step>
      <!-- An answer with no decision fails closed too. -->
      <Step>
        <Name>RF-CalloutFailed</Name>
        <Condition>rail.decision = null</Condition>
      </Step>
      <Step>
        <Name>RF-Refuse</Name>
        <Condition>rail.decision = "refuse"</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <!-- Request streaming stays off (the default): a streamed request reaches
       the callout with no content, and an empty body may be refused. -->
  <HTTPProxyConnection>
    <BasePath>__BASE_PATH__</BasePath>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
