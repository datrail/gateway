# Loaded automatically by terraform plan/apply. Keep project_id, region,
# prefix and rail_timeout_ms in sync with ../../scripts/config.env, which the
# scripts read.
project_id      = "your-project"
region          = "us-central1"
prefix          = "g2p"
apigee_instance = "g2p-usc1"
apigee_envgroup = "g2p-envgroup"
apigee_env      = "g2p-env"
apigee_env_type = "BASE"
rail_timeout_ms = 5000
