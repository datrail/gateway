{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/mcp",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.method == 'notifications/initialized')]"
      }
    ]
  },
  "response": {
    "status": 202,
    "headers": {
      "Mcp-Session-Id": "e2e-upstream-session"
    }
  }
}
