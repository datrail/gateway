<?xml version="1.0" encoding="UTF-8"?>
<ProxyEndpoint name="default">
  <FaultRules>
    <!-- Any fault before the callout decided (unreachable, timed out, refused
         by IAM, a gRPC error) fails closed. RF-Refuse and target errors come
         after a decision, so they don't match. -->
    <FaultRule name="callout-failed">
      <Step>
        <Name>RF-CalloutFailed</Name>
      </Step>
      <Condition>rail.decision = null</Condition>
    </FaultRule>
  </FaultRules>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>EC-Rail</Name>
      </Step>
      <Step>
        <Name>RF-Refuse</Name>
        <Condition>rail.decision = "refuse"</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <!-- Request streaming stays off (the default): a streamed request reaches
       the callout with no content, and an empty body may be refused. -->
  <HTTPProxyConnection>
    <BasePath>__BASE_PATH__</BasePath>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
