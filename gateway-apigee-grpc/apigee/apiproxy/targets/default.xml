<?xml version="1.0" encoding="UTF-8"?>
<!-- No <Authentication>: the agent's Authorization reaches the target as
     sent. -->
<TargetEndpoint name="default">
  <PreFlow name="PreFlow">
    <Request/>
    <Response/>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <HTTPTargetConnection>
    <URL>__TARGET_URL__</URL>
  </HTTPTargetConnection>
</TargetEndpoint>
